{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",

  "parameters": {
    "assetLocationURI": {
      "type": "string",
      "metadata": {
        "description": "The location of resources, such as templates, that the template depends on. Leave as default unless using a fork."
      },
      "defaultValue": "https://raw.githubusercontent.com/LioDiera/reprolabv2/master/"
    },
    "vmName": {
      "type": "string",
      "metadata": {
        "description": "Name for the new VM."
      },
      "defaultValue": "EXTRAVM1",
      "maxLength": 15
    },
    "vnetName": {
      "type": "string",
      "metadata": {
        "description": "Name of the existing virtual network to attach the VM to."
      },
      "defaultValue": "syncnet"
    },
    "vnetResourceGroup": {
      "type": "string",
      "metadata": {
        "description": "Resource group where the existing virtual network lives. Leave blank to use the same resource group as this deployment."
      },
      "defaultValue": ""
    },
    "subnetName": {
      "type": "string",
      "metadata": {
        "description": "Name of the subnet within the existing VNet to attach the VM to."
      },
      "defaultValue": "CorpNet"
    },
    "adminUsername": {
      "type": "string",
      "metadata": {
        "description": "Local administrator username for the new VM."
      },
      "defaultValue": "LabAdmin"
    },
    "adminPassword": {
      "type": "securestring",
      "minLength": 12,
      "maxLength": 123,
      "metadata": {
        "description": "Administrator password for the new VM. Must be 12-123 characters and contain 3 of: uppercase, lowercase, numbers, special characters."
      }
    },
    "adminPasswordConfirm": {
      "type": "securestring",
      "minLength": 12,
      "maxLength": 123,
      "metadata": {
        "description": "Confirm the administrator password by entering it again exactly as above."
      }
    },
    "joinDomain": {
      "type": "bool",
      "metadata": {
        "description": "Whether to join the new VM to the existing Active Directory domain."
      },
      "defaultValue": true
    },
    "adDSdomainName": {
      "type": "string",
      "metadata": {
        "description": "The FQDN of the existing AD DS domain to join. Only required when Join Domain is true."
      },
      "defaultValue": "synclab.local"
    },
    "domainAdminUsername": {
      "type": "string",
      "metadata": {
        "description": "Username of an account with domain join rights. Only required when Join Domain is true."
      },
      "defaultValue": "LabAdmin"
    },
    "domainAdminPassword": {
      "type": "securestring",
      "metadata": {
        "description": "Password for the domain admin account. Only required when Join Domain is true."
      },
      "defaultValue": ""
    },
    "OSImage": {
      "type": "string",
      "minLength": 1,
      "allowedValues": [
        "2012-R2-Datacenter",
        "2012-Datacenter",
        "2016-Datacenter",
        "2019-Datacenter",
        "2022-Datacenter",
        "2025-Datacenter"
      ],
      "metadata": {
        "description": "The Windows Server OS version for the new VM."
      },
      "defaultValue": "2019-Datacenter"
    },
    "vmSize": {
      "type": "string",
      "allowedValues": [
        "Standard_D2s_v3",
        "Standard_DS1_v2",
        "Standard_B2s"
      ],
      "metadata": {
        "description": "VM size for the new virtual machine."
      },
      "defaultValue": "Standard_B2s"
    },
    "diskStorageType": {
      "type": "string",
      "defaultValue": "Standard_LRS",
      "allowedValues": [
        "Standard_LRS",
        "StandardSSD_LRS"
      ],
      "metadata": {
        "description": "Disk storage type: Standard_LRS (Standard HDD) for best cost or StandardSSD_LRS (Standard SSD) for better performance."
      }
    },
    "addPublicIP": {
      "type": "bool",
      "defaultValue": false,
      "metadata": {
        "description": "Assign a public IP address to this VM. Only needed if you require direct internet access or RDP from outside the VNet."
      }
    }
  },

  "variables": {
    "computedVmName": "[parameters('vmName')]",
    "computedVnetName": "[parameters('vnetName')]",
    "computedSubnetName": "[parameters('subnetName')]",
    "resolvedVnetResourceGroup": "[if(equals(parameters('vnetResourceGroup'), ''), resourceGroup().name, parameters('vnetResourceGroup'))]",
    "subnetId": "[resourceId(variables('resolvedVnetResourceGroup'), 'Microsoft.Network/virtualNetworks/subnets', variables('computedVnetName'), variables('computedSubnetName'))]",
    "passwordsMatch": "[equals(parameters('adminPassword'), parameters('adminPasswordConfirm'))]",
    "passwordValidation": "[if(variables('passwordsMatch'), parameters('adminPassword'), div(1, 0))]",
    "templateLocationURI": "[concat(parameters('assetLocationURI'), 'Templates/')]",
    "DomainJoin-DeploymentName": "[concat(deployment().Name, '-AdditionalVM-DomainJoin')]"
  },

  "resources": [
    {
      "condition": "[parameters('addPublicIP')]",
      "type": "Microsoft.Network/publicIPAddresses",
      "name": "[concat(variables('computedVmName'), '-pip')]",
      "apiVersion": "2021-02-01",
      "location": "[resourceGroup().location]",
      "sku": { "name": "Basic" },
      "properties": {
        "publicIPAllocationMethod": "Dynamic"
      }
    },
    {
      "type": "Microsoft.Network/networkInterfaces",
      "name": "[concat(variables('computedVmName'), '-NIC')]",
      "apiVersion": "2021-02-01",
      "location": "[resourceGroup().location]",
      "dependsOn": [
        "[resourceId('Microsoft.Network/publicIPAddresses', concat(variables('computedVmName'), '-pip'))]"
      ],
      "properties": {
        "ipConfigurations": [
          {
            "name": "ipconfig",
            "properties": {
              "privateIPAllocationMethod": "Dynamic",
              "subnet": {
                "id": "[variables('subnetId')]"
              },
              "publicIPAddress": "[if(parameters('addPublicIP'), createObject('id', resourceId('Microsoft.Network/publicIPAddresses', concat(variables('computedVmName'), '-pip'))), null())]"
            }
          }
        ]
      }
    },
    {
      "type": "Microsoft.Compute/virtualMachines",
      "name": "[variables('computedVmName')]",
      "apiVersion": "2019-07-01",
      "location": "[resourceGroup().location]",
      "dependsOn": [
        "[resourceId('Microsoft.Network/networkInterfaces', concat(variables('computedVmName'), '-NIC'))]"
      ],
      "properties": {
        "hardwareProfile": {
          "vmSize": "[parameters('vmSize')]"
        },
        "osProfile": {
          "computerName": "[variables('computedVmName')]",
          "adminUsername": "[parameters('adminUsername')]",
          "adminPassword": "[variables('passwordValidation')]",
          "windowsConfiguration": {
            "provisionVMAgent": true,
            "enableAutomaticUpdates": true
          }
        },
        "storageProfile": {
          "imageReference": {
            "publisher": "MicrosoftWindowsServer",
            "offer": "WindowsServer",
            "sku": "[parameters('OSImage')]",
            "version": "latest"
          },
          "osDisk": {
            "name": "[concat(variables('computedVmName'), '-osdisk')]",
            "createOption": "FromImage",
            "managedDisk": {
              "storageAccountType": "[parameters('diskStorageType')]"
            },
            "caching": "ReadWrite"
          }
        },
        "networkProfile": {
          "networkInterfaces": [
            {
              "id": "[resourceId('Microsoft.Network/networkInterfaces', concat(variables('computedVmName'), '-NIC'))]"
            }
          ]
        }
      }
    },
    {
      "condition": "[parameters('joinDomain')]",
      "name": "[variables('DomainJoin-DeploymentName')]",
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2016-02-01",
      "dependsOn": [
        "[resourceId('Microsoft.Compute/virtualMachines', variables('computedVmName'))]"
      ],
      "properties": {
        "mode": "Incremental",
        "templateLink": {
          "uri": "[concat(variables('templateLocationURI'), 'VM-domain-join.json')]",
          "contentVersion": "1.0.0.0"
        },
        "parameters": {
          "vmName": { "value": "[variables('computedVmName')]" },
          "domainToJoin": { "value": "[parameters('adDSdomainName')]" },
          "domainUsername": { "value": "[parameters('domainAdminUsername')]" },
          "domainPassword": { "value": "[parameters('domainAdminPassword')]" }
        }
      }
    }
  ],

  "outputs": {
    "vmName": {
      "type": "string",
      "value": "[variables('computedVmName')]"
    },
    "subnetId": {
      "type": "string",
      "value": "[variables('subnetId')]"
    }
  }
}
